{
  "name": "nashmi-eduverse-backend",
  "version": "2.0.0",
  "description": "Nashmi EduVerse Nexus - Advanced Educational Platform Backend",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js --fix",
    "build": "npm run lint && npm test",
    "docker:build": "docker build -t nashmi-backend .",
    "docker:run": "docker run -p 5000:5000 nashmi-backend",
    "migrate": "npx sequelize-cli db:migrate",
    "seed": "npx sequelize-cli db:seed:all"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "nodemailer": "^6.9.9",
    "redis": "^4.6.13",
    "mongoose": "^8.2.0",
    "socket.io": "^4.7.5",
    "axios": "^1.6.7",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.2",
    "node-cron": "^3.0.3",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.5",
    "winston": "^3.11.0",
    "moment": "^2.30.1",
    "lodash": "^4.17.21",
    "joi": "^17.12.1",
    "apollo-server-express": "^3.12.1",
    "graphql": "^16.8.1",
    "web3": "^4.6.0",
    "ethers": "^6.11.1",
    "openai": "^4.28.4",
    "@tensorflow/tfjs-node": "^4.17.0",
    "python-shell": "^5.0.0",
    "three": "^0.161.0",
    "aframe": "^1.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5"
  },
  "keywords": [
    "education",
    "platform",
    "learning",
    "ai",
    "vr",
    "ar",
    "blockchain",
    "gamification",
    "nashmi",
    "btec",
    "jordan"
